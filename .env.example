# Senha para entrar no painel (obrigatória)
APP_PASSWORD=troque-esta-senha

# Segredo para assinar a sessão — gere um aleatório: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=gere-um-segredo-aleatorio

# Segredo que vai na URL dos webhooks de venda (ex.: uma string longa aleatória)
WEBHOOK_SECRET=gere-outro-segredo

# true = dados fictícios para testar sem token da Meta
DEMO_MODE=true

PORT=3000
# 127.0.0.1 = só acessível localmente (use com Nginx na VPS). 0.0.0.0 = aberto na rede
HOST=127.0.0.1

# Na VPS com HTTPS (Nginx): COOKIE_SECURE=true e TRUST_PROXY=true
COOKIE_SECURE=false
TRUST_PROXY=false

META_API_VERSION=v23.0
TZ_PAINEL=America/Sao_Paulo
